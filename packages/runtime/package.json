{
  "name": "@atelier/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Atelier render runtime — framework-agnostic core: manifest fetcher/resolver, action dispatcher, trigger bus, component registry, render-plan derivation",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@atelier/policies": "workspace:*",
    "@atelier/schemas": "workspace:*",
    "idb-keyval": "^6.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "restricted"
  }
}

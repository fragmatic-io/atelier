{
  "name": "@atelier/compiler",
  "version": "0.5.0",
  "private": false,
  "description": "Atelier compiler service — turns capabilities + skills + components + intent + trigger into a manifest",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@atelier/policies": "workspace:^",
    "@atelier/schemas": "workspace:^",
    "@google/genai": "^2.0.1",
    "redis": "^5.12.1"
  }
}

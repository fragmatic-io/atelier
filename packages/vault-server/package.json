{
  "name": "@atelier/vault-server",
  "version": "0.1.0",
  "private": true,
  "description": "Atelier intent vault server — node:http + ed25519 JWTs + JSON-file storage. Mints scoped read tokens, enforces scope-based filtering, emits revocation triggers.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@atelier/schemas": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "restricted"
  }
}

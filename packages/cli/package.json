{
  "name": "@atelier/cli",
  "version": "0.1.0",
  "private": false,
  "description": "Atelier unified developer CLI — `atelier init`, `atelier dev`, `atelier add`, `atelier validate`",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "atelier": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@atelier/compiler": "workspace:*",
    "@atelier/components": "workspace:*",
    "@atelier/schemas": "workspace:*",
    "@atelier/vault-client": "workspace:*",
    "@atelier/vault-server": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}

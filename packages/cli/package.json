{
  "name": "@atelier/cli",
  "version": "0.5.0",
  "private": false,
  "description": "Atelier unified developer CLI — `atelier init`, `atelier dev`, `atelier add`, `atelier validate`",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "atelier": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@atelier/compiler": "workspace:^",
    "@atelier/components": "workspace:^",
    "@atelier/schemas": "workspace:^",
    "@atelier/vault-client": "workspace:^",
    "@atelier/vault-server": "workspace:^"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}

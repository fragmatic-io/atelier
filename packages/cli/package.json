{
  "name": "@cir/cli",
  "version": "0.1.0",
  "private": false,
  "description": "CIR unified developer CLI — `cir init`, `cir dev`, `cir add`, `cir validate`",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "cir": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@cir/compiler": "workspace:*",
    "@cir/components": "workspace:*",
    "@cir/schemas": "workspace:*",
    "@cir/vault-server": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}

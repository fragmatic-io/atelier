/**
 * Server-side singleton for {{appName}} — wires the compiler, manifest
 * cache, and audit sink the manifest API delegates to.
 *
 * This file is the canonical hand-off point for hosts that want to
 * customise Atelier's compile pipeline. Drop in a different
 * `CompilerService`, swap `MemoryManifestStore` for `RedisManifestStore`,
 * or layer a `BudgetMeteredCompiler` around the Gemini call.
 *
 * Pinned to the published package surface — no monorepo internals.
 */

import {
  CompositeCompiler,
  GeminiCompiler,
  GenericFallbackCompiler,
  MemoryManifestStore,
  ServerManifestResolver,
  type CompilerService,
  type ManifestStore,
} from '@atelier/compiler';
import { BASELINE_POLICIES, validateManifest } from '@atelier/policies';
import { StreamingAuditSink } from '@atelier/runtime';
import type {
  BrandKit,
  Capability,
  ComponentDefinition,
  Manifest,
} from '@atelier/schemas';

import brandKitJson from '../brand-kit.json' with { type: 'json' };

interface AtelierServer {
  compiler: CompilerService;
  store: ManifestStore;
  audit: StreamingAuditSink;
  resolver: ServerManifestResolver;
  capabilities: Record<string, Capability>;
  components: ComponentDefinition[];
  brandKit: BrandKit;
  geminiAvailable: boolean;
}

const KEY = '__atelier_server';
type GlobalWithServer = typeof globalThis & { [KEY]?: AtelierServer };
const g = globalThis as GlobalWithServer;

/**
 * Validate a freshly compiled manifest against the baseline policies.
 * The resolver runs this on every cache miss.
 */
function validateManifestSemantics(manifest: Manifest): {
  ok: boolean;
  reasons?: readonly string[];
} {
  const result = validateManifest(
    {
      manifest,
      capabilities: SERVER_CAPABILITIES,
      intent: {
        user_id: 'starter-user',
        global_preferences: {},
        granted_fields: ['*'],
      },
      rate_limited_capability_ids: new Set(),
      pii_fields: new Set(),
      brand_kit: brandKitJson as BrandKit,
    },
    { policies: [...BASELINE_POLICIES] },
  );
  const reasons = result.violations.map((v) => v.message);
  return result.ok ? { ok: true, reasons } : { ok: false, reasons };
}

/**
 * Capability registry. Edit this map (or load from
 * `capabilities/*.json` at boot) to expose more capabilities to the
 * compiler. Each key MUST match the capability's `id`.
 */
const SERVER_CAPABILITIES: Record<string, Capability> = {
  'starter.items.list': {
    id: 'starter.items.list',
    kind: 'data',
    version: '0.1.0',
    input: { filter: 'string' },
    output: {
      items: 'array<{ id: string, title: string, body: string, created_at: datetime }>',
    },
    side_effects: ['reads:starter_items'],
    permissions: ['starter:read'],
    confirmation: 'none',
    rate_limit: '60/min/user',
    reversible: true,
  },
  'starter.items.create': {
    id: 'starter.items.create',
    kind: 'action',
    version: '0.1.0',
    input: { title: 'string', body: 'string' },
    output: { id: 'string', created_at: 'datetime' },
    side_effects: ['mutates:starter_items', 'post'],
    permissions: ['starter:write'],
    confirmation: 'modal',
    rate_limit: '20/min/user',
    reversible: true,
    rollback: 'starter.items.delete',
  },
};

/**
 * Baseline component catalog. Generated from `@atelier/components`'
 * registry — pinned here as a tiny subset for the starter. Add more IDs
 * as you author manifests that need them.
 */
const BASELINE_COMPONENT_IDS = [
  'Stack',
  'Container',
  'Card',
  'Markdown',
  'List',
  'Grid',
  'EmptyState',
  'Button',
  'NavBar',
] as const;

const COMPONENTS: ComponentDefinition[] = BASELINE_COMPONENT_IDS.map((id) => ({
  id,
  props_schema: `${id}Props`,
  data_sources:
    id === 'List' || id === 'Grid' ? ['starter.items.list'] : [],
  actions_supported: id === 'Button' ? ['starter.items.create'] : [],
  responsive_targets: ['web'],
  design_tokens: '{{appName}}.brand@0.1.0',
  examples: [],
  text_render: true,
})) as ComponentDefinition[];

function buildServer(): AtelierServer {
  const audit = new StreamingAuditSink({ bufferSize: 200, echoToConsole: false });

  const apiKey = process.env['GEMINI_API_KEY'];
  const geminiAvailable = !!apiKey && apiKey.length > 10;

  const compilers: CompilerService[] = [];
  if (geminiAvailable) {
    compilers.push(
      new GeminiCompiler({
        apiKey: apiKey!,
        coldModel: process.env['GEMINI_COLD_MODEL'] ?? 'gemini-2.5-pro',
        diffModel: process.env['GEMINI_DIFF_MODEL'] ?? 'gemini-2.5-flash',
      }),
    );
  }
  // Always include the deterministic fallback at the end of the chain so
  // the demo still boots without a Gemini key.
  compilers.push(new GenericFallbackCompiler());

  const compiler = new CompositeCompiler(compilers, {
    onCascade: (from, err) => {
      // eslint-disable-next-line no-console
      console.warn(`[atelier] compiler ${from} failed; cascading. err:`, err);
    },
  });

  const store = new MemoryManifestStore({ maxEntries: 200 });

  const resolver = new ServerManifestResolver({
    compiler,
    store,
    audit: (e) => audit.emit(e),
    validate: validateManifestSemantics,
  });

  return {
    compiler,
    store,
    audit,
    resolver,
    capabilities: SERVER_CAPABILITIES,
    components: COMPONENTS,
    brandKit: brandKitJson as BrandKit,
    geminiAvailable,
  };
}

export function getAtelierServer(): AtelierServer {
  if (!g[KEY]) g[KEY] = buildServer();
  return g[KEY];
}

{
  "id": "{{appName}}.brand",
  "version": "0.1.0",
  "tokens": {
    "colors": {
      "brand.primary": "#6e56cf",
      "brand.primary.fg": "#ffffff",
      "brand.accent": "#67e8f9",
      "surface.app.light": "#fafafb",
      "surface.app.dark": "#0a0a0c",
      "fg.primary.light": "#1c1c20",
      "fg.primary.dark": "#f5f5f7",
      "state.success": "#34d399",
      "state.warning": "#fbbf24",
      "state.danger": "#e5484d"
    },
    "spacing": {
      "xs": "4px",
      "sm": "8px",
      "md": "12px",
      "lg": "16px",
      "xl": "24px",
      "2xl": "32px"
    },
    "typography": {
      "font_stack": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "scale": {
        "sm": "12px",
        "md": "14px",
        "lg": "16px",
        "xl": "20px",
        "2xl": "24px"
      },
      "weight": {
        "regular": "400",
        "medium": "500",
        "semibold": "600",
        "bold": "700"
      }
    },
    "radius": {
      "xs": "4px",
      "sm": "6px",
      "md": "8px",
      "lg": "12px"
    }
  },
  "variants": {},
  "voice": {
    "tone": "imperative + technical",
    "do": ["start with a verb", "use sentence case for headings and buttons"],
    "dont": ["exclamation marks", "marketing tone"]
  },
  "iconography": {
    "allowed_sets": ["lucide"],
    "minimum_size": 14
  },
  "accessibility": {
    "contrast_minimum": 4.5,
    "focus_ring_required": true
  }
}

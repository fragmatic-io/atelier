# Atelier — environment for the standalone scaffold.
#
# Copy this file to `.env.local` and fill in the values you need. Empty
# values are tolerated; the demo will fall back to deterministic compile
# and an in-memory vault.

# Gemini API key. When set, the real LLM compile path runs. Without it,
# Atelier's GenericFallbackCompiler ships hand-written manifests.
GEMINI_API_KEY=

# Vault URL — where the runtime mints + redeems intent tokens.
# `pnpm dev` boots `atelier vault dev` on 4001 by default.
NEXT_PUBLIC_VAULT_URL=http://localhost:4001

{
  "name": "@atelier/eval-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "Atelier marketplace eval gate — runs the top-N approved personas through a frozen reference compile + ManifestSchema + policy validation, surfaces an EvalReport per nightly run",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@atelier/policies": "workspace:*",
    "@atelier/schemas": "workspace:*",
    "@atelier/vault-server": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "restricted"
  }
}

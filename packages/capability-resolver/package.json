{
  "name": "@atelier/capability-resolver",
  "version": "0.0.0",
  "private": true,
  "description": "Atelier capability scoping — substring + two-stage (tiny-model) resolvers that plug into ToolUsingCompiler's SemanticSearch seam",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "dependencies": {
    "@atelier/compiler": "workspace:*",
    "@atelier/schemas": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}

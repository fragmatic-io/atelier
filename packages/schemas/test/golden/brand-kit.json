{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://cir.dev/schemas/brand-kit.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+"
    },
    "tokens": {
      "type": "object",
      "properties": {
        "colors": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "spacing": {
          "$ref": "#/properties/tokens/properties/colors"
        },
        "typography": {
          "type": "object",
          "properties": {
            "font_stack": {
              "type": "string"
            },
            "scale": {
              "$ref": "#/properties/tokens/properties/colors"
            },
            "weight": {
              "$ref": "#/properties/tokens/properties/colors"
            },
            "letter_spacing": {
              "$ref": "#/properties/tokens/properties/colors"
            },
            "line_height": {
              "$ref": "#/properties/tokens/properties/colors"
            },
            "opentype": {
              "type": "object",
              "properties": {
                "tabular_numerals": {
                  "type": "boolean"
                },
                "ligatures": {
                  "type": "string",
                  "enum": [
                    "common",
                    "discretionary",
                    "none"
                  ]
                },
                "optical_sizing": {
                  "type": "boolean"
                },
                "fractions": {
                  "type": "boolean"
                },
                "superscript": {
                  "type": "boolean"
                },
                "subscript": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "font_stack",
            "scale"
          ],
          "additionalProperties": false
        },
        "motion": {
          "type": "object",
          "properties": {
            "duration": {
              "$ref": "#/properties/tokens/properties/colors"
            },
            "easing": {
              "$ref": "#/properties/tokens/properties/colors"
            }
          },
          "required": [
            "duration",
            "easing"
          ],
          "additionalProperties": false
        },
        "radius": {
          "$ref": "#/properties/tokens/properties/colors"
        },
        "shadow": {
          "$ref": "#/properties/tokens/properties/colors"
        },
        "notification": {
          "type": "object",
          "properties": {
            "counter_bg": {
              "type": "string"
            },
            "counter_fg": {
              "type": "string"
            },
            "mention_bg": {
              "type": "string"
            },
            "mention_fg": {
              "type": "string"
            },
            "pulse_ms": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "colors",
        "spacing",
        "typography"
      ],
      "additionalProperties": false
    },
    "variants": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "voice": {
      "type": "object",
      "properties": {
        "tone": {
          "type": "string"
        },
        "do": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dont": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "surfaces": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "tone": {
                "type": "string",
                "minLength": 1
              },
              "example": {
                "type": "string"
              }
            },
            "required": [
              "tone"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "tone",
        "do",
        "dont"
      ],
      "additionalProperties": false
    },
    "radius_scale": {
      "$ref": "#/properties/tokens/properties/colors"
    },
    "shadow_scale": {
      "$ref": "#/properties/tokens/properties/colors"
    },
    "elevation_scale": {
      "type": "object",
      "properties": {
        "resting": {
          "type": "object",
          "properties": {
            "light": {
              "type": "string",
              "minLength": 1
            },
            "dark": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "light",
            "dark"
          ],
          "additionalProperties": false
        },
        "hover": {
          "$ref": "#/properties/elevation_scale/properties/resting"
        },
        "popover": {
          "$ref": "#/properties/elevation_scale/properties/resting"
        },
        "modal": {
          "$ref": "#/properties/elevation_scale/properties/resting"
        },
        "commandbar": {
          "$ref": "#/properties/elevation_scale/properties/resting"
        }
      },
      "required": [
        "resting",
        "hover",
        "popover",
        "modal",
        "commandbar"
      ],
      "additionalProperties": false
    },
    "motion": {
      "type": "object",
      "properties": {
        "duration_scale": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "easing": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "duration_scale"
      ],
      "additionalProperties": false
    },
    "iconography": {
      "type": "object",
      "properties": {
        "allowed_sets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "minimum_size": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "allowed_sets",
        "minimum_size"
      ],
      "additionalProperties": false
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "contrast_minimum": {
          "type": "number",
          "minimum": 1
        },
        "focus_ring_required": {
          "type": "boolean"
        }
      },
      "required": [
        "contrast_minimum",
        "focus_ring_required"
      ],
      "additionalProperties": false
    },
    "compile_budget": {
      "type": "object",
      "properties": {
        "max_tokens_per_day": {
          "type": "integer",
          "minimum": 0
        },
        "max_calls_per_hour": {
          "type": "integer",
          "minimum": 0
        },
        "max_tokens_per_call": {
          "type": "integer",
          "minimum": 0
        },
        "on_exhausted": {
          "type": "string",
          "enum": [
            "fall_through",
            "fail"
          ],
          "default": "fall_through"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "version",
    "tokens",
    "variants",
    "voice"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://cir.dev/schemas/intent-profile.json",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^t_[a-z0-9_-]{1,63}$"
    },
    "profile_version": {
      "type": "integer",
      "minimum": 0
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "global_preferences": {
      "type": "object",
      "additionalProperties": {}
    },
    "lenses": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "locked": {
            "type": "boolean"
          }
        },
        "required": [
          "scope",
          "rule",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": {}
    },
    "cross_app_workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "uses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "name",
          "trigger",
          "uses"
        ],
        "additionalProperties": false
      }
    },
    "compile_budget": {
      "type": "object",
      "properties": {
        "max_tokens_per_day": {
          "type": "integer",
          "minimum": 0
        },
        "max_calls_per_hour": {
          "type": "integer",
          "minimum": 0
        },
        "max_tokens_per_call": {
          "type": "integer",
          "minimum": 0
        },
        "on_exhausted": {
          "type": "string",
          "enum": [
            "fall_through",
            "fail"
          ],
          "default": "fall_through"
        }
      },
      "additionalProperties": false
    },
    "priority_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "signal": {
            "type": "string",
            "enum": [
              "urgency",
              "recency",
              "unread",
              "assigned_to_me",
              "starred",
              "due_date"
            ]
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "domain",
          "signal"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "user_id",
    "profile_version",
    "updated_at",
    "global_preferences",
    "lenses",
    "rules",
    "vocabulary"
  ],
  "additionalProperties": false
}

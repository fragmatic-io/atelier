{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://cir.dev/schemas/policy.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "applies_to": {
      "type": "string",
      "enum": [
        "manifest",
        "action",
        "data"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "error",
        "warn",
        "info"
      ]
    }
  },
  "required": [
    "id",
    "description",
    "applies_to",
    "severity"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://cir.dev/schemas/thread-manifest.json",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "minLength": 1
    },
    "thread": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "turn": {
            "type": "integer",
            "minimum": 0
          },
          "manifest_id": {
            "type": "string",
            "pattern": "^m_[a-z0-9]{8,}$"
          },
          "rendered_components": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
            }
          }
        },
        "required": [
          "turn",
          "manifest_id",
          "rendered_components"
        ],
        "additionalProperties": false
      }
    },
    "total_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "total_actions_executed": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "conversation_id",
    "thread",
    "total_tokens",
    "total_actions_executed"
  ],
  "additionalProperties": false
}

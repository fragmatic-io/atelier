{
  "name": "@atelier/data-resolvers",
  "version": "0.1.0",
  "private": true,
  "description": "Atelier data resolver adapters — REST, OpenAPI, GraphQL, Mock, Composite, plus a SWR-style cache wrapper. Plug into the `DataResolver` protocol from @atelier/react so manifest data bindings resolve to real data without hand-rolling a fetch layer.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@atelier/schemas": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "restricted"
  }
}

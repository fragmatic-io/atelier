{
  "name": "@atelier/components",
  "version": "0.1.0",
  "private": true,
  "description": "Atelier baseline React component library — unstyled, semantic primitives that fit ComponentBinding",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./registry": "./src/registry.ts",
    "./composition-rules": "./src/composition-rules.ts",
    "./density-resolver": "./src/density-resolver.ts",
    "./_variants": "./src/components/_variants.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@atelier/keyboard": "workspace:*",
    "@atelier/runtime": "workspace:*",
    "@atelier/schemas": "workspace:*",
    "@tanstack/react-virtual": "^3.10.0",
    "lucide-react": "^1.14.0",
    "react-markdown": "^9.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "shiki": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.9.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "restricted"
  }
}

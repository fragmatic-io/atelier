{
  "name": "@atelier/components",
  "version": "0.5.0",
  "private": false,
  "description": "Atelier baseline React component library — unstyled, semantic primitives that fit ComponentBinding",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    },
    "./composition-rules": {
      "types": "./dist/composition-rules.d.ts",
      "default": "./dist/composition-rules.js"
    },
    "./density-resolver": {
      "types": "./dist/density-resolver.d.ts",
      "default": "./dist/density-resolver.js"
    },
    "./_variants": {
      "types": "./dist/components/_variants.d.ts",
      "default": "./dist/components/_variants.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "storybook:build": "storybook build --quiet --output-dir storybook-static",
    "storybook:dev": "storybook dev",
    "storybook:visual": "playwright test --config storybook/playwright.config.ts",
    "storybook:visual:compiled": "playwright test --config storybook/playwright.compiled-workflows.config.ts",
    "storybook:visual:compiled:update-baselines": "playwright test --config storybook/playwright.compiled-workflows.config.ts --update-snapshots",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@atelier/keyboard": "workspace:^",
    "@atelier/runtime": "workspace:^",
    "@atelier/schemas": "workspace:^",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-virtual": "^3.10.0",
    "lucide-react": "^1.14.0",
    "react-markdown": "^9.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "shiki": {
      "optional": true
    }
  },
  "devDependencies": {
    "@atelier/compiler": "workspace:^",
    "@atelier/policies": "workspace:^",
    "@atelier/react": "workspace:^",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.11.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "storybook": "^10.5.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}

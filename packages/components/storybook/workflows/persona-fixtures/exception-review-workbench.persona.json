{
  "$schema": "../persona-fixture.schema.json",
  "name": "exception-review-workbench",
  "route": "/exceptions",
  "title": "Exception review workbench — confirm-and-resolve",
  "intent": {
    "user_id": "persona-exception-review",
    "profile_version": 1,
    "updated_at": "2026-05-03T00:00:00.000Z",
    "global_preferences": {
      "density": "compact",
      "color_mode": "light",
      "motion_preference": "reduced",
      "automation_trust": "strict",
      "modal_tolerance": "medium"
    },
    "lenses": { "ops": "exception_review_workbench" },
    "rules": [
      {
        "scope": "*",
        "rule": "Resolutions must always confirm and write an audit line.",
        "version": 1,
        "locked": true
      },
      {
        "scope": "ops",
        "rule": "Render exceptions as a 5-row queue with a focused exception record on the right and an audit log strip beneath.",
        "version": 1
      }
    ],
    "vocabulary": {
      "exception": "a transactional event flagged by policy that needs ops review",
      "audit_line": "the human-readable trail entry written on resolution"
    }
  },
  "capabilities": {
    "exception.list": {
      "id": "exception.list",
      "kind": "data",
      "version": "1.0.0",
      "input": {},
      "output": {
        "id": "string",
        "title": "string",
        "customer": "string",
        "severity": "string",
        "status": "string",
        "amount": "string",
        "owner": "string",
        "age": "string"
      },
      "side_effects": [],
      "permissions": ["exception:read"],
      "confirmation": "none",
      "reversible": true
    },
    "exception.resolve": {
      "id": "exception.resolve",
      "kind": "action",
      "version": "1.0.0",
      "input": { "exception_id": "string", "note": "string" },

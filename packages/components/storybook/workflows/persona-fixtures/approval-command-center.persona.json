        "scope": "*",
        "rule": "Always confirm reversible approvals; never auto-execute restricted_fields actions.",
        "version": 1,
        "locked": true
      },
      {
        "scope": "ops",
        "rule": "Render approvals as a queue list on the left and a focused record detail on the right.",
        "version": 1
      },
      {
        "scope": "ops",
        "rule": "Bind the approvals list to `approval.list`. Keep the data binding simple — no `filter` or `sort` is required; the capability returns the full pending queue ordered by due date.",
        "version": 1
      }
    ],
    "vocabulary": {
      "approval": "request to dispatch a capability that requires policy gating",
      "policy_owner": "the on-call reviewer for a given policy class"
    }
  },
  "capabilities": {
    "approval.list": {
      "id": "approval.list",
      "kind": "data",
      "version": "1.0.0",
      "input": {},
      "output": {
        "id": "string",
        "title": "string",
        "requester": "string",
        "policy": "string",
        "impact": "string",
        "status": "string",
        "due": "string"
      },
      "side_effects": [],
      "permissions": ["approval:read"],
      "confirmation": "none",
      "reversible": true
    },

{
  "name": "@cir/vault-client",
  "version": "0.1.0",
  "private": true,
  "description": "CIR vault client — typed wire client for @cir/vault-server. JWKS-cached signature verification, pluggable token storage, typed errors.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@cir/schemas": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "restricted"
  }
}

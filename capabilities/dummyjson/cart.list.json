{
  "id": "dummyjson.cart.list",
  "kind": "data",
  "version": "0.1.0",
  "input": {
    "user_id": "number"
  },
  "output": {
    "products": "array<{ id: number, title: string, price: number, quantity: number, total: number, thumbnail: string }>",
    "total": "number",
    "discountedTotal": "number",
    "totalProducts": "number",
    "totalQuantity": "number"
  },
  "side_effects": ["reads:cart_state"],
  "permissions": ["cart:read"],
  "confirmation": "none",
  "rate_limit": "120/min/user",
  "reversible": true
}

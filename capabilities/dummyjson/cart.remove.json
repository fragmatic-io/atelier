{
  "id": "dummyjson.cart.remove",
  "kind": "action",
  "version": "0.1.0",
  "input": {
    "user_id": "number",
    "product_id": "number"
  },
  "output": {
    "cart_id": "number",
    "total_products": "number",
    "total_quantity": "number",
    "removed_at": "datetime"
  },
  "side_effects": ["mutates:cart_state"],
  "permissions": ["cart:write"],
  "confirmation": "inline",
  "rate_limit": "60/min/user",
  "reversible": true,
  "rollback": "dummyjson.cart.add",
  "low_stakes": true
}

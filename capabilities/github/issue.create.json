{
  "id": "github.issue.create",
  "kind": "action",
  "version": "0.1.0",
  "input": {
    "owner": "string",
    "repo": "string",
    "title": "string",
    "body": "string",
    "labels": "array<string>"
  },
  "output": {
    "number": "number",
    "html_url": "string",
    "created_at": "datetime"
  },
  "side_effects": ["mutates:github_issues", "post"],
  "permissions": ["github:write"],
  "confirmation": "modal",
  "rate_limit": "20/min/user",
  "reversible": true,
  "rollback": "github.issue.close"
}

{
  "id": "github.issue.close",
  "kind": "action",
  "version": "0.1.0",
  "input": {
    "owner": "string",
    "repo": "string",
    "issue_number": "number",
    "reason": "string"
  },
  "output": {
    "number": "number",
    "state": "string",
    "closed_at": "datetime"
  },
  "side_effects": ["mutates:github_issues"],
  "permissions": ["github:write"],
  "confirmation": "inline",
  "rate_limit": "30/min/user",
  "reversible": true,
  "rollback": "github.issue.reopen"
}

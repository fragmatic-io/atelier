NODE_ENV=production
ATELIER_PUBLIC_ORIGIN=https://atelier.example.com
ATELIER_BIND=127.0.0.1
PORT=4310
ATELIER_DATA_DIR=/var/lib/atelier
ATELIER_DB_PATH=/var/lib/atelier/atelier.sqlite
ATELIER_MASTER_KEYS_FILE=/etc/atelier/master-keys.json
ATELIER_ACTIVE_KEY_ID=primary
ATELIER_WORKER=false
ATELIER_WORKER_CONCURRENCY=1
ATELIER_ENABLE_EXAMPLES=false
ATELIER_TRUST_LOOPBACK_PROXY=true
# Keep true through bootstrap; false prevents new workspaces, not new projects.
ATELIER_ALLOW_TENANT_CREATION=true
# Comma-separated approved HTTPS compatibility API hostnames, never arbitrary user URLs.
ATELIER_PROVIDER_HOSTS=

[Unit]
Description=Atelier API and Studio
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=atelier
Group=atelier
WorkingDirectory=/opt/atelier
EnvironmentFile=/etc/atelier/platform.env
ExecStart=/usr/bin/node /opt/atelier/scripts/start.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/atelier
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=1G
TasksMax=128

[Install]
WantedBy=multi-user.target

# CIR demo environment template.
#
# Copy this file to `.env.local` (which is gitignored) before running the demo.
# All values shown here are sensible local-dev defaults; flip them as needed.

# ─── Compiler ─────────────────────────────────────────────────────────────────
# Optional: when set, /api/cir/onboarding/compile and the route compiler use
# Gemini 2.5 Pro (cold) + Flash (diff). Without a key, the FallbackCompiler
# runs — the demo still boots and onboarding still produces a profile.
GEMINI_API_KEY=

# Override the model ids if you want to point at a different version.
# GEMINI_COLD_MODEL=gemini-2.5-pro
# GEMINI_DIFF_MODEL=gemini-2.5-flash

# ─── Vault ────────────────────────────────────────────────────────────────────
# Where the demo's intent-store should look for a vault. The repo's
# `pnpm demo` orchestration boots @cir/vault-server on this URL.
NEXT_PUBLIC_VAULT_URL=http://localhost:4001

# Vault behaviour when unreachable. `allow` falls back to localStorage with a
# console warning (recommended for local dev). `disabled` fails closed —
# production deployments should use this.
NEXT_PUBLIC_VAULT_FALLBACK=allow

# ─── App identity ─────────────────────────────────────────────────────────────
# These are claims passed to the vault when minting grants.
NEXT_PUBLIC_DEMO_APP_ID=cir.demo

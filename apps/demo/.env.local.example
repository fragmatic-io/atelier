# Atelier demo environment template.
#
# Copy this file to `.env.local` (gitignored) before running. Atelier's
# thesis is **dynamic UI**: routes are LLM-compiled from a recipe +
# intent + the catalog. A demo without a Gemini key falls back to
# hand-written manifests, which is fine for offline iteration but is
# NOT representative of how Atelier is meant to render in production. See
# `docs/ethos.md` principle #1.

# ─── Compiler (REQUIRED for the showcase experience) ────────────────────
# Get a key from https://aistudio.google.com/apikey. The pipeline is:
#   GeminiCompiler (cold = gemini-2.5-pro, diff = gemini-2.5-flash)
#     → cascade to FallbackCompiler on network blip / validation
#       failure / rate-limit.
#
# Without a key, the demo runs entirely on hand-written fallback. Token
# counter stays at 0; the framework's dynamic-UI thesis is NOT being
# demonstrated.
GEMINI_API_KEY=

# Override the model ids if you want to point at a different version.
# GEMINI_COLD_MODEL=gemini-2.5-pro
# GEMINI_DIFF_MODEL=gemini-2.5-flash

# ─── Vault ────────────────────────────────────────────────────────────────────
# Where the demo's intent-store should look for a vault. The repo's
# `pnpm demo` orchestration boots @atelier/vault-server on this URL.
NEXT_PUBLIC_VAULT_URL=http://localhost:4001

# Vault behaviour when unreachable. `allow` falls back to localStorage with a
# console warning (recommended for local dev). `disabled` fails closed —
# production deployments should use this.
NEXT_PUBLIC_VAULT_FALLBACK=allow

# ─── App identity ─────────────────────────────────────────────────────────────
# These are claims passed to the vault when minting grants.
NEXT_PUBLIC_DEMO_APP_ID=cir.demo

{
  "name": "cir",
  "version": "0.0.0",
  "private": true,
  "description": "Capability · Intent · Render — a production architecture for dynamic software interfaces",
  "license": "Apache-2.0",
  "author": {
    "name": "The CIR Authors",
    "email": "v@fragmatic.io"
  },
  "homepage": "https://github.com/fragmatic-io/cir#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/fragmatic-io/cir.git"
  },
  "bugs": {
    "url": "https://github.com/fragmatic-io/cir/issues"
  },
  "keywords": [
    "cir",
    "capability",
    "intent",
    "render",
    "ui",
    "manifest",
    "agent",
    "llm",
    "framework"
  ],
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc --build",
    "typecheck:watch": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{js,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

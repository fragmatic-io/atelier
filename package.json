{
  "name": "atelier",
  "version": "0.0.0",
  "private": true,
  "description": "Atelier — Capability · Intent · Render — a production architecture for dynamic software interfaces",
  "license": "MIT",
  "author": {
    "name": "The Atelier Authors",
    "email": "v@fragmatic.io"
  },
  "homepage": "https://github.com/fragmatic-io/atelier#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/fragmatic-io/atelier.git"
  },
  "bugs": {
    "url": "https://github.com/fragmatic-io/atelier/issues"
  },
  "keywords": [
    "atelier",
    "cir",
    "capability",
    "intent",
    "render",
    "ui",
    "manifest",
    "agent",
    "llm",
    "framework"
  ],
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm build:all",
    "build:all": "pnpm -r --if-present --workspace-concurrency=1 build",
    "smoke-test:pack": "tsx scripts/smoke-test-pack.ts",
    "smoke-test:init": "tsx scripts/smoke-test-init.ts",
    "smoke-test:init:structure": "tsx scripts/smoke-test-init.ts --skip-install",
    "publish:dry-run": "pnpm -r --filter \"./packages/*\" publish --dry-run --no-git-checks",
    "release": "tsx scripts/release.ts",
    "release:dry": "tsx scripts/release.ts patch",
    "typecheck": "tsc --build",
    "typecheck:watch": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:license-headers": "tsx scripts/check-license-headers.ts",
    "fix:license-headers": "tsx scripts/check-license-headers.ts --fix",
    "components:sync": "tsx --tsconfig packages/components/tsconfig.json scripts/sync-component-registry.ts",
    "components:check": "tsx --tsconfig packages/components/tsconfig.json scripts/sync-component-registry.ts --check",
    "components:storybook:dev": "pnpm --filter @atelier/components storybook:dev",
    "components:storybook:build": "pnpm --filter @atelier/components storybook:build",
    "components:storybook:visual": "pnpm --filter @atelier/components storybook:visual",
    "components:storybook:visual:compiled": "pnpm --filter @atelier/components storybook:visual:compiled",
    "components:storybook:visual:update-baselines": "pnpm --filter @atelier/components storybook:visual:compiled:update-baselines",
    "capabilities:index": "tsx --tsconfig packages/schemas/tsconfig.json scripts/generate-capability-index.ts",
    "capabilities:index:check": "tsx --tsconfig packages/schemas/tsconfig.json scripts/generate-capability-index.ts --check",
    "capabilities:validate-changed": "tsx --tsconfig packages/schemas/tsconfig.json scripts/validate-capabilities-incremental.ts",
    "atelier": "tsx packages/cli/src/index.ts",
    "demo": "tsx scripts/dev-demo.ts",
    "docs:dev": "pnpm --filter @atelier/docs dev",
    "docs:build": "pnpm --filter @atelier/docs build",
    "schemas:dump": "node packages/schemas/dist/cli/index.js dump --out .well-known/schemas",
    "schemas:check-ajv": "tsx scripts/check-schemas-ajv.ts",
    "validate:data": "node packages/schemas/dist/cli/index.js validate-data",
    "evals": "atelier-evals run",
    "marketplace:eval": "tsx scripts/marketplace-eval.ts",
    "marketplace-cost-dashboard": "tsx scripts/marketplace-cost-dashboard.ts",
    "validate:fast": "pnpm build && pnpm check:license-headers && pnpm typecheck && pnpm lint && pnpm format:check && pnpm components:check && pnpm capabilities:index:check && pnpm validate:data && pnpm schemas:check-ajv",
    "validate": "pnpm build && pnpm check:license-headers && pnpm typecheck && pnpm lint && pnpm format:check && pnpm components:check && pnpm capabilities:index:check && pnpm validate:data && pnpm schemas:check-ajv && pnpm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@atelier/cli": "workspace:*",
    "@atelier/docs": "workspace:*",
    "@atelier/capability-resolver": "workspace:*",
    "@atelier/compiler": "workspace:*",
    "@atelier/components": "workspace:*",
    "@atelier/data-resolvers": "workspace:*",
    "@atelier/demo": "workspace:*",
    "@atelier/demo-dummyjson": "workspace:*",
    "@atelier/eval-marketplace": "workspace:*",
    "@atelier/evals": "workspace:*",
    "@atelier/policies": "workspace:*",
    "@atelier/react": "workspace:*",
    "@atelier/recipe-resolver": "workspace:*",
    "@atelier/runtime": "workspace:*",
    "@atelier/schemas": "workspace:*",
    "@atelier/keyboard": "workspace:*",
    "@atelier/vault-client": "workspace:*",
    "@atelier/vault-server": "workspace:*",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitest/coverage-v8": "^4.1.9",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-glob": "^3.3.2",
    "globals": "^17.6.0",
    "happy-dom": "^20.10.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.61.0",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{js,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp"
    ]
  }
}

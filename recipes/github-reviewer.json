{
  "manifest_id": "m_ghreview01",
  "user_id": "github-reviewer",
  "app_id": "demo.github.cir",
  "compiled_from": {
    "capability_version": "0.1.0",
    "skill_versions": {
      "github-issue-triage": "0.1.0"
    },
    "component_catalog_version": "0.1.0",
    "intent_profile_version": 0,
    "compiler_model": "recipe-author",
    "compiled_at": "2026-04-30T00:00:00Z"
  },
  "ttl": null,
  "invalidates_on": [
    "capability_schema_change:github.repo.list:>=0.2.0",
    "capability_schema_change:github.issue.create:>=0.2.0",
    "capability_schema_change:github.issue.close:>=0.2.0",
    "skill.version_changed:github-issue-triage",
    "explicit_user_request:m_ghreview01"
  ],
  "routes": [
    {
      "path": "/",
      "redirect": "/today"
    },
    {
      "path": "/today",
      "title": "Today",
      "layout": {
        "component": "Stack",
        "children": [
          {
            "component": "NavBar",
            "props": {
              "title": "GitHub Reviewer",
              "links": [
                { "label": "Today", "href": "/today" },
                { "label": "Repos", "href": "/repos" }
              ]
            }
          },
          {
            "component": "Container",
            "props": { "variant": "tinted" },
            "children": [
              {
                "component": "List",
                "data": {
                  "source": "github.repo.list",
                  "sort": "updated_at desc"
                },
                "actions": ["github.issue.create"]
              },
              {
                "component": "EmptyState",
                "props": {
                  "title": "No repos yet",
                  "body": "Sign in with GitHub to see your repositories here."
                }
              }
            ]
          }
        ]
      },
      "refresh": {
        "data": "on_focus + 300s_interval",
        "structure": "never_unless_invalidated"
      }
    },
    {
      "path": "/repos",
      "title": "Repositories",
      "layout": {
        "component": "Stack",
        "children": [
          {
            "component": "Search",
            "props": {
              "placeholder": "Filter repositories",
              "variant": "embedded"
            }
          },
          {
            "component": "List",
            "data": {
              "source": "github.repo.list",
              "sort": "stargazers_count desc"
            },
            "actions": ["github.issue.create", "github.issue.close"]
          }
        ]
      },
      "refresh": {
        "data": "on_focus + 600s_interval",
        "structure": "never_unless_invalidated"
      }
    }
  ],
  "policies_satisfied": [
    "confirmation_required_for_destructive",
    "rate_limited_actions_show_state",
    "reversibility_surfaced",
    "no_destructive_issue_actions_without_confirmation"
  ]
}

# Normalize line endings on checkin; check out as LF on every platform.
* text=auto eol=lf

# Explicit text files (belt-and-braces for the file types we ship).
*.md          text eol=lf
*.json        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.js          text eol=lf
*.jsx         text eol=lf
*.mjs         text eol=lf
*.cjs         text eol=lf

# Binary assets — never diff, never normalize.
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.webp        binary
*.pdf         binary
*.zip         binary

# Current generated files — versioned, but excluded from language stats and
# review diffs. The retired pnpm/schema-generator paths no longer exist.
package-lock.json                   linguist-generated=true -diff
platform/PACKAGE-MANIFEST.json      linguist-generated=true -diff

# Normalize line endings on checkin; check out as LF on every platform.
* text=auto eol=lf

# Explicit text files (belt-and-braces for the file types we ship).
*.md          text eol=lf
*.json        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.js          text eol=lf
*.jsx         text eol=lf
*.mjs         text eol=lf
*.cjs         text eol=lf

# Binary assets — never diff, never normalize.
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.webp        binary
*.pdf         binary
*.zip         binary

# Generated files — exclude from language stats and diffs.
pnpm-lock.yaml linguist-generated=true -diff
*.lock         linguist-generated=true

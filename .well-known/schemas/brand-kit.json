{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://cir.dev/schemas/brand-kit.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+"
    },
    "tokens": {
      "type": "object",
      "properties": {
        "colors": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "spacing": {
          "$ref": "#/properties/tokens/properties/colors"
        },
        "typography": {
          "type": "object",
          "properties": {
            "font_stack": {
              "type": "string"
            },
            "scale": {
              "$ref": "#/properties/tokens/properties/colors"
            },
            "weight": {
              "$ref": "#/properties/tokens/properties/colors"
            }
          },
          "required": [
            "font_stack",
            "scale"
          ],
          "additionalProperties": false
        },
        "motion": {
          "type": "object",
          "properties": {
            "duration": {
              "$ref": "#/properties/tokens/properties/colors"
            },
            "easing": {
              "$ref": "#/properties/tokens/properties/colors"
            }
          },
          "required": [
            "duration",
            "easing"
          ],
          "additionalProperties": false
        },
        "radius": {
          "$ref": "#/properties/tokens/properties/colors"
        },
        "shadow": {
          "$ref": "#/properties/tokens/properties/colors"
        }
      },
      "required": [
        "colors",
        "spacing",
        "typography"
      ],
      "additionalProperties": false
    },
    "variants": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "voice": {
      "type": "object",
      "properties": {
        "tone": {
          "type": "string"
        },
        "do": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dont": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "surfaces": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "tone": {
                "type": "string",
                "minLength": 1
              },
              "example": {
                "type": "string"
              }
            },
            "required": [
              "tone"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "tone",
        "do",
        "dont"
      ],
      "additionalProperties": false
    },
    "radius_scale": {
      "$ref": "#/properties/tokens/properties/colors"
    },
    "shadow_scale": {
      "$ref": "#/properties/tokens/properties/colors"
    },
    "motion": {
      "type": "object",
      "properties": {
        "duration_scale": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "easing": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "duration_scale"
      ],
      "additionalProperties": false
    },
    "iconography": {
      "type": "object",
      "properties": {
        "allowed_sets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "minimum_size": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "allowed_sets",
        "minimum_size"
      ],
      "additionalProperties": false
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "contrast_minimum": {
          "type": "number",
          "minimum": 1
        },
        "focus_ring_required": {
          "type": "boolean"
        }
      },
      "required": [
        "contrast_minimum",
        "focus_ring_required"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "version",
    "tokens",
    "variants",
    "voice"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://cir.dev/schemas/intent-profile.json",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "profile_version": {
      "type": "integer",
      "minimum": 0
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "global_preferences": {
      "type": "object",
      "additionalProperties": {}
    },
    "lenses": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "locked": {
            "type": "boolean"
          }
        },
        "required": [
          "scope",
          "rule",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": {}
    },
    "cross_app_workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "uses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "name",
          "trigger",
          "uses"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "user_id",
    "profile_version",
    "updated_at",
    "global_preferences",
    "lenses",
    "rules",
    "vocabulary"
  ],
  "additionalProperties": false
}

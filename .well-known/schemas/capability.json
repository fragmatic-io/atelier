{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://cir.dev/schemas/capability.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "action",
        "data"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[\\w.-]+)?(?:\\+[\\w.-]+)?$"
    },
    "input": {
      "type": "object",
      "additionalProperties": {}
    },
    "output": {
      "$ref": "#/properties/input"
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:mutates:[a-z0-9_.-]+|reads:[a-z0-9_.-]+|[a-z][a-z0-9_]*)$"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]*:[a-z][a-z0-9_.-]*$"
      }
    },
    "confirmation": {
      "type": "string",
      "enum": [
        "none",
        "inline",
        "modal",
        "verbal_required"
      ]
    },
    "rate_limit": {
      "type": "string",
      "pattern": "^\\d+\\/(sec|min|hour|day)\\/(user|org|global)$"
    },
    "reversible": {
      "type": "boolean"
    },
    "rollback": {
      "$ref": "#/properties/id"
    },
    "low_stakes": {
      "type": "boolean"
    },
    "salience_default": {
      "type": "string"
    },
    "salience_level": {
      "type": "string",
      "enum": [
        "high",
        "normal",
        "low"
      ]
    },
    "undoable": {
      "type": "boolean"
    },
    "undo_window_ms": {
      "type": "integer",
      "minimum": 1
    },
    "expected_count": {
      "type": "integer",
      "minimum": 0
    },
    "_review": {
      "type": "object",
      "properties": {
        "needs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "imported_from": {
          "type": "string",
          "minLength": 1
        },
        "imported_at": {
          "type": "string",
          "format": "date-time"
        },
        "importer_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "needs",
        "imported_from",
        "imported_at",
        "importer_version"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "kind",
    "version",
    "input",
    "output",
    "side_effects",
    "permissions",
    "confirmation",
    "reversible"
  ],
  "additionalProperties": false
}

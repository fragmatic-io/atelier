{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://cir.dev/schemas/composition-rules.json",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "properties": {
      "can_contain": {
        "anyOf": [
          {
            "type": "string",
            "const": "*"
          },
          {
            "type": "string",
            "const": "leaf"
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
            }
          }
        ]
      },
      "min_children": {
        "type": "integer",
        "minimum": 0
      },
      "max_children": {
        "type": "integer",
        "minimum": 0
      },
      "props": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "required": [
      "can_contain"
    ],
    "additionalProperties": false
  },
  "propertyNames": {
    "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
  }
}

{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://cir.dev/schemas/turn-delta.json",
  "type": "object",
  "properties": {
    "delta_type": {
      "type": "string",
      "enum": [
        "extend",
        "modify",
        "replace"
      ]
    },
    "previous_manifest": {
      "type": "string",
      "pattern": "^m_[a-z0-9]{8,}$"
    },
    "new_manifest": {
      "$ref": "#/properties/previous_manifest"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "op"
        ],
        "additionalProperties": {}
      }
    },
    "tokens_used": {
      "type": "integer",
      "minimum": 0
    },
    "model": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "delta_type",
    "previous_manifest",
    "new_manifest",
    "changes",
    "tokens_used",
    "model"
  ],
  "additionalProperties": false
}
